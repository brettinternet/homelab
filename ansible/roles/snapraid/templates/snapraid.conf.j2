# {{ ansible_managed }}
# Source https://github.com/amadvance/snapraid/blob/master/snapraid.conf.example

{% for path in snapraid__parity %}
{{ loop.index }}-parity {{ path }}
{% endfor %}

{% for path in snapraid__content %}
content {{ path }}
{% endfor %}

{% for name, path in snapraid__data.items() %}
data {{ name }} {{ path }}
{% endfor %}

# See https://www.snapraid.it/manual "Pattern"
# Files/dirs to include/exclude (relative to mount points)
exclude *.unrecoverable
exclude /tmp/
exclude /lost+found/
exclude /media/usenet/
exclude /media/torrent/
exclude /media/cameras/
exclude /media/library/filler/output/
exclude snapshots/
exclude *.!sync
exclude .AppleDouble
exclude ._AppleDouble
exclude .DS_Store
exclude ._.DS_Store
exclude .Thumbs.db
exclude .fseventsd
exclude .Spotlight-V100
exclude .TemporaryItems
exclude .Trashes
exclude .Trash-*
exclude .Trash-*/
exclude .AppleDB
include /media/library/
